{
  "name": "localpilot",
  "productName": "LocalPilot",
  "version": "0.1.0",
  "description": "Desktop chat + coding agent for local models served by LM Studio",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . LocalPilot --platform=darwin --arch=arm64 --out=dist --overwrite --icon=build/icon.icns --ignore=^/dist --ignore=^/relay --ignore=^/docs --ignore=^/test",
    "test:network": "node test/network/channel.test.js && node test/network/relay.test.js && node test/network/manager.test.js"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^37.10.3"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "dompurify": "^3.4.17",
    "marked": "^15.0.12",
    "ws": "^8.22.0"
  }
}
